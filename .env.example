# ---------------------------------------------------------------------------
# Ebenezer Educational Centre - environment configuration
# Copy this file to ".env" and fill in real values.
# ---------------------------------------------------------------------------

# Core ----------------------------------------------------------------------
# Generate a new key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=Africa/Accra

# Database ------------------------------------------------------------------
# Leave blank in development to use SQLite (db.sqlite3).
# Production example:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=False
# Set to True in production so the site refuses to boot without a real database.
REQUIRE_PRODUCTION_DB=False

# Email ---------------------------------------------------------------------
# Development uses the console backend (emails print to the terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=Ebenezer Educational Centre <noreply@localhost>
SERVER_EMAIL=
# Fallback recipients for enquiry alerts (comma separated).
SCHOOL_NOTIFICATION_EMAIL=

# Security (used when DEBUG=False) -----------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_AGE=1209600

# Application tuning --------------------------------------------------------
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
ANALYTICS_RETENTION_DAYS=180
MAX_UPLOAD_SIZE=5242880

# Initial admin (only read by `python manage.py create_initial_admin`) ------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
